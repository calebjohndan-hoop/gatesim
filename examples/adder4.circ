# 4-bit ripple carry adder: {COUT,S3..S0} = A3..A0 + B3..B0 + CIN
# Built from one reusable full adder module, instantiated four times.

MODULE FA A B CIN -> SUM COUT
    XOR T1   A B
    XOR SUM  T1 CIN
    AND T2   T1 CIN
    AND T3   A B
    OR  COUT T2 T3
END

INPUT  A3 A2 A1 A0 B3 B2 B1 B0 CIN
OUTPUT COUT S3 S2 S1 S0

INSTANCE FA U0 A0 B0 CIN -> S0 C1
INSTANCE FA U1 A1 B1 C1  -> S1 C2
INSTANCE FA U2 A2 B2 C2  -> S2 C3
INSTANCE FA U3 A3 B3 C3  -> S3 COUT
